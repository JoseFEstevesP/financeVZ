<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext habilitado para servir el APK desde un servidor local de la LAN durante las pruebas. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
