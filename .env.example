# Copia este archivo a .env. El .env está ignorado por git: no contenga secretos en el repo.
# dev = APK sin firma (debug). prod = APK firmado con el keystore de abajo.
MODE=dev

# Solo se usan cuando MODE=prod. El keystore se crea con scripts/setup-keystore.sh.
# Si un valor tiene espacios o '#', escríbelo entre comillas.
FINANCEVZ_KEYSTORE_PATH=$HOME/.config/financevz/financevz-release.jks
FINANCEVZ_KEYSTORE_PASSWORD=
FINANCEVZ_KEY_PASSWORD=
FINANCEVZ_KEY_ALIAS=financevz
