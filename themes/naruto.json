{
  "id": "naruto",
  "name": "Naruto",
  "description": "Naranja ninja, oscuro y con bordes afilados.",
  "css_class": "theme-naruto",
  "is_dark": true,
  "preview": [
    "#111216",
    "#1c1f26",
    "#ff8a00",
    "#e53935"
  ],
  "vars": {
    "--bg": "#111216",
    "--text": "#f5f5f5",
    "--muted": "#c7c9d1",
    "--card": "#1c1f26",
    "--border": "#ff8a00",
    "--input-bg": "#151821",
    "--input-border": "#3b4252",
    "--primary": "#ff8a00",
    "--primary-text": "#111216",
    "--accent": "#e53935",
    "--link": "#7cc7ff",
    "--link-border": "#ff8a00",
    "--chip-bg": "#151821",
    "--chip-text": "#f5f5f5",
    "--chip-active-bg": "#3a2500",
    "--nav-bg": "#151821",
    "--nav-border": "#ff8a00",
    "--hero-start": "#3a2500",
    "--hero-end": "#111216",
    "--hero-border": "#e53935",
    "--secondary-bg": "#2a2f3a",
    "--secondary-text": "#f5f5f5",
    "--row-border": "#343b48",
    "--toast-bg": "#2d2010",
    "--toast-text": "#fff3e0",
    "--toast-border": "#ff8a00",
    "--alert-bg": "#3a1717",
    "--alert-border": "#e53935",
    "--urgent": "#ff8a00",
    "--positive": "#7bd88f",
    "--negative": "#ff6b6b",
    "--overlay": "rgba(10,10,14,.94)",
    "--modal-bg": "#1c1f26",
    "--bar-bg": "#151821",
    "--bar-start": "#ff8a00",
    "--bar-end": "#e53935",
    "--evidence-bg": "#151821",
    "--file-border": "#ff8a00",
    "--file-active": "#3a2500",
    "--shadow": "rgba(255,138,0,.22)"
  },
  "extra_css": ".theme-naruto .card{border-left:4px solid #ff8a00;border-radius:.75rem 1rem 1rem .75rem;}\n.theme-naruto .hero{background:linear-gradient(135deg,#3a2500 0%,#1c1f26 45%,#2a1010 100%);border-left:4px solid #e53935;}\n.theme-naruto .primary{border-radius:.5rem;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));}\n.theme-naruto .chip.active,.theme-naruto .tab.active{box-shadow:inset 0 -2px 0 #ff8a00;}\n.theme-naruto .topbar{border-bottom:2px solid #ff8a00;}\n.theme-naruto .modal{border-radius:.75rem;border-top:3px solid #e53935;}\n",
  "builtin": false
}
