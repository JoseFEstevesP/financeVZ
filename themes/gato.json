{
  "id": "gato",
  "name": "Gato",
  "description": "Suave, redondeado y pastel, con vibra felina.",
  "css_class": "theme-gato",
  "is_dark": false,
  "preview": [
    "#fff7fb",
    "#ffeef6",
    "#b388eb",
    "#ff8fab"
  ],
  "vars": {
    "--bg": "#fff7fb",
    "--text": "#4a3553",
    "--muted": "#7a6285",
    "--card": "#ffffff",
    "--border": "#f0cde0",
    "--input-bg": "#fff0f7",
    "--input-border": "#e7bfd6",
    "--primary": "#b388eb",
    "--primary-text": "#ffffff",
    "--accent": "#ff8fab",
    "--link": "#8b5cf6",
    "--link-border": "#d8b4fe",
    "--chip-bg": "#fff0f7",
    "--chip-text": "#5c4468",
    "--chip-active-bg": "#efe0ff",
    "--nav-bg": "#ffffff",
    "--nav-border": "#f0cde0",
    "--hero-start": "#efe0ff",
    "--hero-end": "#ffeef6",
    "--hero-border": "#d8b4fe",
    "--secondary-bg": "#efe0ff",
    "--secondary-text": "#5c4468",
    "--row-border": "#f3dce8",
    "--toast-bg": "#efe0ff",
    "--toast-text": "#5c4468",
    "--toast-border": "#b388eb",
    "--alert-bg": "#fff0da",
    "--alert-border": "#f2c078",
    "--urgent": "#c07a00",
    "--positive": "#7cbf8e",
    "--negative": "#e57373",
    "--overlay": "rgba(74,53,83,.35)",
    "--modal-bg": "#ffffff",
    "--bar-bg": "#fff0f7",
    "--bar-start": "#b388eb",
    "--bar-end": "#ff8fab",
    "--evidence-bg": "#fff0f7",
    "--file-border": "#d8b4fe",
    "--file-active": "#efe0ff",
    "--shadow": "rgba(179,136,235,.2)"
  },
  "extra_css": ".theme-gato .card,.theme-gato .modal,.theme-gato .hero{border-radius:1.75rem;box-shadow:0 10px 30px rgba(179,136,235,.12);}\n.theme-gato .primary,.theme-gato .secondary,.theme-gato .chip,.theme-gato .text-input,.theme-gato .amount-input,.theme-gato .settings-button{border-radius:999px;}\n.theme-gato .hero{background:linear-gradient(135deg,#efe0ff 0%,#ffeef6 50%,#fff7fb 100%);}\n.theme-gato .bottom-nav{border-radius:1.5rem 1.5rem 0 0;margin:0 .5rem;box-shadow:0 -4px 20px rgba(179,136,235,.08);}\n.theme-gato .expense-icon,.theme-gato .file-drop-icon{border-radius:1rem;}\n",
  "builtin": false
}
