{
  "id": "perro",
  "name": "Perro",
  "description": "Cálido, amigable y robusto, con tonos tierra.",
  "css_class": "theme-perro",
  "is_dark": false,
  "preview": [
    "#fffaf3",
    "#f5ead7",
    "#8b5e3c",
    "#4c8c4a"
  ],
  "vars": {
    "--bg": "#fffaf3",
    "--text": "#3e2c1c",
    "--muted": "#76614d",
    "--card": "#fffdf8",
    "--border": "#dbc8a8",
    "--input-bg": "#f8f1e3",
    "--input-border": "#ccb58e",
    "--primary": "#8b5e3c",
    "--primary-text": "#fffaf3",
    "--accent": "#4c8c4a",
    "--link": "#5a7d3a",
    "--link-border": "#b79b73",
    "--chip-bg": "#f8f1e3",
    "--chip-text": "#4a3726",
    "--chip-active-bg": "#efe0c8",
    "--nav-bg": "#fffdf8",
    "--nav-border": "#dbc8a8",
    "--hero-start": "#efe0c8",
    "--hero-end": "#fffaf3",
    "--hero-border": "#c8a97a",
    "--secondary-bg": "#efe0c8",
    "--secondary-text": "#4a3726",
    "--row-border": "#eadfc9",
    "--toast-bg": "#e8f3e3",
    "--toast-text": "#2f5a2d",
    "--toast-border": "#4c8c4a",
    "--alert-bg": "#fff0d9",
    "--alert-border": "#d39b45",
    "--urgent": "#b45309",
    "--positive": "#4c8c4a",
    "--negative": "#c44b3f",
    "--overlay": "rgba(62,44,28,.4)",
    "--modal-bg": "#fffdf8",
    "--bar-bg": "#f8f1e3",
    "--bar-start": "#8b5e3c",
    "--bar-end": "#4c8c4a",
    "--evidence-bg": "#f8f1e3",
    "--file-border": "#b79b73",
    "--file-active": "#efe0c8",
    "--shadow": "rgba(139,94,60,.18)"
  },
  "extra_css": ".theme-perro .card,.theme-perro .hero,.theme-perro .modal{border-radius:1.25rem;border-width:2px;box-shadow:0 8px 0 rgba(139,94,60,.08);}\n.theme-perro .primary{border-radius:1rem;box-shadow:0 4px 0 #6b4528;}\n.theme-perro .primary:active{transform:translateY(2px);box-shadow:0 2px 0 #6b4528;}\n.theme-perro .chip,.theme-perro .secondary,.theme-perro .text-input,.theme-perro .amount-input{border-radius:1rem;}\n.theme-perro .bottom-nav{border-top:3px solid #8b5e3c;}\n.theme-perro .tab.active .tab-icon{transform:scale(1.08);}\n",
  "builtin": false
}
